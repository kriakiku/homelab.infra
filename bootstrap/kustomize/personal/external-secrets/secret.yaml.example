# This file is NOT applied by kustomize — it's a reference for manual secret creation.
#
# Run BEFORE `just bootstrap cluster`:
#
#   kubectl create ns external-secrets --dry-run=client -o yaml | kubectl apply -f -
#   kubectl -n external-secrets create secret generic vaultwarden-secret \
#     --from-literal=token=<GENERATED> \
#     --from-literal=client_id=user.8fc3a70e-ffaa-4afc-891f-c01ebfc9e43c \
#     --from-literal=client_secret=<YOURS> \
#     --from-literal=organization_id=76cb6e80-15c7-4fb8-8a11-e7489a28c045
#
# Token is obtained via:
#   curl -sX POST https://vault.1337.pet/identity/connect/token \
#     -d "grant_type=client_credentials&client_id=...&client_secret=...&scope=api" \
#     | jq -r '.access_token'
---
apiVersion: v1
kind: Secret
metadata:
  name: vaultwarden-secret
stringData:
  token: ""
  client_id: user.8fc3a70e-ffaa-4afc-891f-c01ebfc9e43c
  client_secret: <client_secret>
  organization_id: 76cb6e80-15c7-4fb8-8a11-e7489a28c045
